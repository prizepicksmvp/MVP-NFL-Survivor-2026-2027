---
import "../../styles.css";

const baseUrl = import.meta.env.BASE_URL;
const fromBase = (path) => `${baseUrl}${path}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Past Weeks | MVP Survivor Challenge</title>
  <meta name="description" content="Past weeks of the PrizePicks MVP Survivor Challenge — pick % breakdowns and the survivor ladder." />
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a href={baseUrl} class="brand-link">
        <div class="brand">
          <img src={fromBase("assets/logo-on-dark.png")} alt="PrizePicks" />
          <span class="brand-name">MVP Survivor<small>Presented by PrizePicks</small></span>
        </div>
      </a>
      <nav class="site-nav">
        <a href="#" data-pick-link data-locked-label="Picks Locked" target="_blank" rel="noopener" class="nav-cta">Make Your Pick</a>
        <a href={`${baseUrl}#this-week`}>This Week</a>
        <a href={fromBase("history")} class="current">Past Weeks</a>
        <a href={`${baseUrl}#rules`}>Rules</a>
      </nav>
    </div>
  </header>
  <section class="history-hero">
    <div class="wrap">
      <span class="eyebrow"><span class="dot"></span> Season Archive</span>
      <h1 class="hero-title" style="font-size: clamp(2rem, 4.5vw, 3rem);">Past weeks</h1>
      <p class="hero-sub">The survivor ladder shows how the field has thinned out. Scroll down for every week's full pick breakdown.</p>
    </div>
  </section>
  <section id="ladder-section">
    <div class="wrap">
      <div class="section-head">
        <h2>Survivor ladder</h2>
        <p>Green = survived that week, red = eliminated, blue = result pending.</p>
      </div>
      <div class="ladder" id="ladder">
        <p class="state-msg">Loading history…</p>
      </div>
    </div>
  </section>
  <section id="weeks">
    <div class="wrap">
      <div class="section-head">
        <h2>Week by week</h2>
        <p>Most recent week first.</p>
      </div>
      <div id="weeks-list">
        <p class="state-msg">Loading weeks…</p>
      </div>
    </div>
  </section>
  <footer>
    <div class="wrap" style="display:flex; justify-content:space-between; width:100%; flex-wrap:wrap; gap:10px;">
      <span>PrizePicks MVP Survivor Challenge</span>
      <span><a href={baseUrl}>&larr; Back to this week</a></span>
    </div>
  </footer>
  <script>
    window.SURVIVOR_BASE_URL = import.meta.env.BASE_URL;
  </script>
  <script>
    import "../../config.js";
    import "../../shared.js";
    import "../../history.js";
  </script>
</body>
</html>
