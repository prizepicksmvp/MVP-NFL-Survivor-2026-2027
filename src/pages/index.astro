---
import "../../styles.css";

const baseUrl = import.meta.env.BASE_URL;
const appBaseUrl = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const fromBase = (path) => `${appBaseUrl}${path.replace(/^\/+/, "")}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MVP Survivor Challenge | PrizePicks</title>
  <meta name="description" content="The PrizePicks MVP Survivor Challenge — pick one QB to clear 1.5 combined touchdowns every week. Miss, and you're out." />
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
</head>
<body>

  <header class="site-header">
    <div class="wrap">
      <a href={appBaseUrl} class="brand-link">
        <div class="brand">
          <img src={fromBase("assets/logo-on-dark.png")} alt="PrizePicks" />
          <span class="brand-name">MVP Survivor<small>Presented by PrizePicks</small></span>
        </div>
      </a>
      <nav class="site-nav">
        <a href="#" data-pick-link data-locked-label="Picks Locked" target="_blank" rel="noopener" class="nav-cta">Make Your Pick</a>
        <a href="#this-week">This Week</a>
        <a href={fromBase("history")}>Past Weeks</a>
        <a href="#rules">Rules</a>
      </nav>
    </div>
  </header>

  <section class="hero">
    <div class="wrap">
      <span class="eyebrow"><span class="dot"></span> MVP Exclusive</span>
      <h1 class="hero-title">One QB. <span class="accent">More than 1.5 TDs.</span><br>Every week or you're out.</h1>
      <p class="hero-sub">
        The Survivor Challenge is simple to play and hard to survive: each week, pick one quarterback
        you believe scores more than <span data-threshold>1.5</span> combined touchdowns — passing,
        rushing, or receiving. Choose correctly and you live to pick again. Miss and you're done. Once
        you've selected a QB, that QB is off the board for you for the rest of the season.
      </p>
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="value" id="current-week-stat">—</span>
          <span class="label">Current Week</span>
        </div>
        <div class="hero-stat">
          <span class="value" id="remaining-stat">—</span>
          <span class="label">Still Alive</span>
        </div>
        <div class="hero-stat">
          <span class="value" id="lock-countdown">—</span>
          <span class="label">Until Picks Lock</span>
        </div>
      </div>

      <div class="hero-cta">
        <a href="#" data-pick-link target="_blank" rel="noopener" class="pick-button">Make Your Pick</a>
        <p class="hero-cta-note" data-lock-note></p>
      </div>
    </div>
  </section>

  <section id="rules">
    <div class="wrap">
      <div class="section-head">
        <h2>How it works</h2>
        <p>Four rules. No exceptions. Get your pick in before kickoff.</p>
      </div>
      <div class="rules-grid">
        <div class="rule-card" tabindex="0">
          <div class="step">Step 01</div>
          <h3>Submit your pick</h3>
          <p>Fill out the weekly survey with the one QB you're riding with before that week's games kick off.</p>
        </div>
        <div class="rule-card" tabindex="0">
          <div class="step">Step 02</div>
          <h3>Clear the threshold</h3>
          <p>Your QB needs more than <span data-threshold>1.5</span> combined touchdowns — passing, rushing, and receiving all count toward the total.</p>
          <span class="threshold-pill">1.5+ combined TDs to survive</span>
        </div>
        <div class="rule-card" tabindex="0">
          <div class="step">Step 03</div>
          <h3>NO REPEATS</h3>
          <p>Once you've picked a quarterback, he's used for the rest of the season — you can't ride with the same QB twice.</p>
        </div>
        <div class="rule-card" tabindex="0">
          <div class="step">Step 04</div>
          <h3>Live to pick again</h3>
          <p>Cash your pick and advance to next week. Miss and you're eliminated from the challenge for the rest of the season.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="this-week">
    <div class="wrap">
      <div class="section-head">
        <h2 id="this-week-heading">This week's pick breakdown</h2>
        <p>Who MVPs are riding with — aggregate percentages only, never individual picks.</p>
      </div>
      <div class="picks-panel" id="picks-panel">
        <p class="state-msg">Loading picks…</p>
      </div>
      <p class="see-history"><a href={fromBase("history")}>See past weeks &rarr;</a></p>
    </div>
  </section>

  <section id="rewards" class="rewards">
    <div class="wrap">
      <div class="section-head">
        <h2>What you're playing for</h2>
        <p>Survive deep enough and the rewards start stacking.</p>
      </div>
      <div class="rewards-grid">
        <div class="reward-card">
          <div class="tier">Week 8</div>
          <h3>Make it to Week 8</h3>
          <p>Still alive when Week 8 kicks off? A $1,000 four-player lineup lands in your account — Flex or Power, your call.</p>
          <span class="reward-pill">$1,000 lineup</span>
        </div>
        <div class="reward-card">
          <div class="tier">Grand Prize</div>
          <h3>Bonus Lineup</h3>
          <p>Outlast the field and you're handed a four man Flex lineup to win $10,000. One roster, the whole season behind it.</p>
          <span class="reward-pill">$10,000 Flex lineup</span>
        </div>
        <div class="reward-card">
          <div class="tier">Grand Prize</div>
          <h3>AFC/NFC Championship Game Tickets</h3>
          <p>The last MVP standing will receive tickets to an AFC or NFC Championship game, with accommodations covered.</p>
          <span class="reward-pill">Tickets + travel</span>
        </div>
      </div>
      <p class="rewards-foot">Reward details are final pending confirmation of playoff matchups and dates.</p>
    </div>
  </section>

  <footer>
    <div class="wrap" style="display:flex; justify-content:space-between; width:100%; flex-wrap:wrap; gap:10px;">
      <span>PrizePicks MVP Survivor Challenge</span>
      <span>Picks are private — only aggregate results are shown.</span>
    </div>
  </footer>

  <script>
    window.SURVIVOR_BASE_URL = import.meta.env.BASE_URL;
  </script>
  <script>
    import "../../config.js";
    import "../../shared.js";
    import "../../index.js";
  </script>
</body>
</html>
